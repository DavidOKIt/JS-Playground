---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
---

<DefaultLayout title="Local Storage">
  <h1>Local Storage</h1>
  <div>
    <button class="countButton">Count Up</button>
    <button class="clearButton">Clear</button>
  </div>
  <span class="count"></span>
  <div>
    <button class="addItemBtn">Add Item</button>
    <button class="clearBasketBtn">Clear Basket</button>
    <button class="clearEverythingBtn">Clear everything</button>
  </div>
  <div class="basket"></div>
  <script src="../../assets/scripts/JS/Aufgaben/Localstorage.js"></script>
</DefaultLayout>
