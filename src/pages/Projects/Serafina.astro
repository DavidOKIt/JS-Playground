---
import DefaultLayout from "../../layouts/DefaultLayout.astro";
import "../../assets/styles/Serafina.scss";
---

<DefaultLayout title="Serafina Project">
  <h1>Serafina Project</h1>
  <div class="ProductWrapper">
    <div class="Product">
      <img class="Product_Img" src="/Dessert.webp" />
    </div>
    <div class="Product_Details">
      <span>Price</span>
      <span>Size</span>
      <div class="Product_Details-color">
        <span>Colors</span>
        <div>
          <button class="btnRed">Red</button>
          <br />
          <button class="btnGreen">Green</button>
        </div>
      </div>
    </div>
  </div>
</DefaultLayout>
<script src="../../assets/scripts/JS/Projects/Serafina.js"></script>
